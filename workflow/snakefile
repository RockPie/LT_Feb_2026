# Extract RunXXX identifiers (padded to 3 digits)
# run_ids_eeemcal = [re.search(r'Run(\d+)\.h2g$', f).group(1).zfill(3) for f in data_files_eeemcal if re.search(r'Run(\d+)\.h2g$', f)]
