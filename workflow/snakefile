run_ids_10g = [re.search(r'Run(\d+)\.h2g$', f).group(1).zfill(3) for f in data_files_10g if re.search(r'Run(\d+)\.h2g$', f)]

LT_SEP_2026_DATA_DIR = GENERAL_DATA_DIR + "/LT_Sep_2026"
data_files_lt_sep_2026 = glob(os.path.join(LT_SEP_2026_DATA_DIR, "Run*.h2g"))
lt_sep_2026_scan_configs = glob("config/LT_Sep_2026_scan_number_*.json")
lt_sep_2026_scan_ids = sorted(
    [re.search(r"scan_number_(\d+)\.json$", path).group(1)
     for path in lt_sep_2026_scan_configs
     if re.search(r"scan_number_(\d+)\.json$", path)],
    key=int)


def is_header_only_h2g(path):
    with open(path, "rb") as raw_file:
        opening = raw_file.readline(4096)
        delimiter = opening.rstrip(b"\r\n")
        if len(delimiter) < 11 or delimiter.strip(b"#"):
            return False
        for header_index in range(256):
            line = raw_file.readline(4096)
            if line.rstrip(b"\r\n") == delimiter:
                return raw_file.read(1) == b""
            if not line.startswith(b"#") or not line.endswith(b"\n"):
                return False
    return False


header_only_lt_sep_2026 = [path for path in data_files_lt_sep_2026 if is_header_only_h2g(path)]
if header_only_lt_sep_2026:
    print("Excluding header-only LT_Sep_2026 runs from aggregate targets: "
          + ", ".join(sorted(header_only_lt_sep_2026)), file=sys.stderr)
data_files_lt_sep_2026 = [path for path in data_files_lt_sep_2026 if path not in header_only_lt_sep_2026]
run_ids_lt_sep_2026 = [re.search(r'Run(\d+)\.h2g$', f).group(1).zfill(3) for f in data_files_lt_sep_2026 if re.search(r'Run(\d+)\.h2g$', f)]

analysis_output_names = sorted(
    os.path.splitext(os.path.basename(path))[0]
    for path in glob("scripts/*.cxx")
    if re.match(r"(?:303|4\d\d)_", os.path.basename(path))
)


rule Rootifier_10G:
    input:
        BUILD_DIR + "/103_Rootifier_10G",
        GENERAL_DATA_DIR + "/Run{run_id}.h2g"
    output:
        DUMP_DIR + "/103_Rootifier_10G/Run{run_id}_rootified.root"
    log:
        LOG_DIR + "/103_Rootifier_10G/Run{run_id}.log"
    shell:
        """
        mkdir -p {LOG_DIR}/103_Rootifier_10G
        mkdir -p {DUMP_DIR}/103_Rootifier_10G
        {input[0]} -f {input[1]} -o {output} &> {log}
        """

