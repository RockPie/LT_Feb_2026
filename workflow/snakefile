rule ToT_Recover:
    input:
        script="build/409_ToT_Recover",
        tot_scan="dump/405_ToT_Scan/ToTScan{scan_id}.root",
        adc_scan="dump/402_ADC_Scan/Scan{scan_id}.root"
    output:
        rootfile="dump/409_ToT_Recover/RecoveredToTScan{scan_id}.root"
    log:
        "logs/409_ToT_Recover/RecoveredToTScan{scan_id}.log"
    shell:
        """
        mkdir -p $(dirname {output.rootfile})
        mkdir -p $(dirname {log})
        {input.script} {input.tot_scan} {input.adc_scan} {output.rootfile} &> {log}
        """
