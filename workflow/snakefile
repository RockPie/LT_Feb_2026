rule clean_analysis:
    message:
        "Removing analysis outputs and logs while preserving stages 101-103"
    params:
        output_dirs=[
            os.path.join(base_dir, analysis_name)
            for base_dir in (DUMP_DIR, LOG_DIR)
            for analysis_name in analysis_output_names
        ]
    run:
        for output_path in params.output_dirs:
            if os.path.isdir(output_path):
                print(f"Removing {output_path}")
                shutil.rmtree(output_path)
            elif os.path.exists(output_path):
                print(f"Removing {output_path}")
                os.remove(output_path)

        for marker_path in glob(os.path.join(DUMP_DIR, "LT_Sep_2026", "*.done")):
            print(f"Removing {marker_path}")
            os.remove(marker_path)
