def get_lt_sep_2026_run_ids(scan_id):
    import json
    config_path = f"config/LT_Sep_2026_scan_number_{scan_id}.json"
    with open(config_path, "r") as config_file:
        scan_config = json.load(config_file)
    return [f"{int(run_id):03d}" for run_id in scan_config["run_numbers"]]


def get_lt_sep_2026_outputs(wildcards, output_pattern):
    return expand(output_pattern, run_id=get_lt_sep_2026_run_ids(wildcards.scan_id))


